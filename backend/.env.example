# Local Postgres (e.g. `brew install postgresql@18 && createdb fpl`)
user=your_postgres_user      # usually your macOS username
password=                    # often empty for a local Homebrew install
host=localhost
port=5432
name=fpl                     # the database where FPL tables will live
DB_SSLMODE=disable           # set to 'require' only for a hosted database
